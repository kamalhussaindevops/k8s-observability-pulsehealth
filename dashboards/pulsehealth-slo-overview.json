        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status_class) (label_replace(rate(nginx_ingress_controller_requests[1m]), \"status_class\", \"$1xx\", \"status\", \"(.).\\\\.*\"))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ],
      "title": "Request rate by HTTP status class",
